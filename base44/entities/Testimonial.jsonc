      "type": "string",
      "title": "Name"
    },
    "role": {
      "type": "string",
      "title": "Role / Affiliation"
    },
    "quote": {
      "type": "string",
      "title": "Quote"
    },
    "rating": {
      "type": "number",
      "title": "Rating (1-5)"
    },
    "property_type": {
      "type": "string",
      "title": "Legacy: Category"
    },
    "location": {
      "type": "string",
      "title": "Legacy: Location"
    }
  },
  "required": [
    "client_name",
    "quote"
  ],
  "rls": {
